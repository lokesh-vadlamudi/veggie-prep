# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=veggie_prep
DB_USER=veggie_prep
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# AI meal suggestions (OpenAI-compatible chat-completions provider)
# Leave AI_BASE_URL / AI_MODEL empty to disable the feature: the suggestion
# form then shows a clear "not configured" message instead of calling out.
# Only set AI_API_KEY if your provider endpoint requires one; it is used
# server-side only, never stored on suggestions, and never sent to the UI.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=30
